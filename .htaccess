# Disable directory browsing
Options -Indexes

# ----------------------------------------------------------------------
# Protect sensitive project files
# ----------------------------------------------------------------------
# SisisFour intentionally uses the project root as the Web entry point.
# These files are required by the application/CLI but must never be served
# directly by Apache on production hosting.
<FilesMatch "(?i)^(?:\.env(?:\..*)?|env|\.git(?:ignore|attributes|modules)|\.ht(?:access|passwd)|composer\.(?:json|lock)|spark|preload\.php|phpunit(?:\.dist)?\.xml|AGENTS\.md|CONTRIBUTING\.md|README\.md|MANIFEST\.sha256|.*\.(?:sql|sqlite3?|db|bak|backup|old|orig|swp|tmp|log|ini|conf))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------
# Rewrite engine
# ----------------------------------------------------------------------

# Turning on the rewrite engine is necessary for the following rules and features.
# FollowSymLinks must be enabled for this to work.
<IfModule mod_rewrite.c>
	Options +FollowSymlinks
	RewriteEngine On

	# Never expose internal source/runtime directories from the Web root.
	# Public application assets remain available through assets/, uploads/,
	# public/, robots.txt, and the normal CodeIgniter front controller.
	# Deny source, operational tools, private data and archived copies.
	# These rules apply even with the front controller kept in PROJECT ROOT.
	RewriteRule ^(?:\.git|\.github|\.svn)(?:/|$) - [F,L,NC]
	RewriteRule ^(?:app|vendor|writable|tests|database|docs|scripts|tools|builds|system|postman|\.postman)(?:/|$) - [F,L,NC]
	RewriteRule ^_step[^/]*_backup(?:/|$) - [F,L,NC]
	RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
	RewriteRule \.(?:sql|sqlite3?|db|bak|backup|old|orig|swp|tmp|log|ini|conf)(?:/|$) - [F,L,NC]

	# Only static approved public/ entries may be served directly.
	# In particular, public/index.php and arbitrary public uploads are NOT routes.
	RewriteRule ^public/?$ - [F,L,NC]
	RewriteRule ^public/(?!(?:assets/|favicon\.ico$|robots\.txt$)) - [F,L,NC]
	# A PHP/shell file must never be executed from /public/assets or /assets.
	RewriteRule ^(?:public/)?assets/.*\.(?:php[0-9]*|phtml|phar|cgi|pl|py|sh|asp|aspx|jsp)(?:/|$) - [F,L,NC]

	# If you installed CodeIgniter in a subfolder, you will need to
	# change the following line to match the subfolder you need.
	# http://httpd.apache.org/docs/current/mod/mod_rewrite.html#rewritebase
	# RewriteBase /

	# Redirect Trailing Slashes...
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_URI} (.+)/$
	RewriteRule ^ %1 [L,R=301]

	# Rewrite "www.example.com -> example.com"
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
	RewriteRule ^ http://%1%{REQUEST_URI} [R=301,L]

	# Checks to see if the user is attempting to access a valid file,
	# such as an image or css document, if this isn't true it sends the
	# request to the front controller, index.php
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]

	# Ensure Authorization header is passed along
	RewriteCond %{HTTP:Authorization} .
	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule !mod_rewrite.c>
	# If we don't have mod_rewrite installed, all 404's
	# can be sent to index.php, and everything works as normal.
	ErrorDocument 404 index.php
</IfModule>

# Disable server signature start
ServerSignature Off
# Disable server signature end
